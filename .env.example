# --- Database ---
DATABASE_URI=postgres://user:password@host:5432/nenenesor

# --- Payload ---
PAYLOAD_SECRET=replace-with-32-char-random-string

# --- Storage (Cloudflare R2 via S3 adapter) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=nene@nenenesor.com

# --- Newsletter (MailerLite) ---
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# --- Captcha (Cloudflare Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nenenesor.com
